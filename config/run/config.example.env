ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
CORS_ALLOW_CREDENTIALS=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mobile_app
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mobile_app
REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_CONNECT_TIMEOUT=30
JWT_SECRET_KEY=change-me-in-production-use-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1
REFRESH_TOKEN_EXPIRE_DAYS=14
OTP_EXPIRE_SECONDS=600
OTP_MAX_ATTEMPTS=5
DEV_OTP_CODE=000000
OTP_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_SENDER_EMAIL=no-reply@example.com
SMTP_SENDER_NAME="Mobile App"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_VERIFY=20/minute
