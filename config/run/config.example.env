ENVIRONMENT=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mobile_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_CONNECT_TIMEOUT=30
DATABASE_RESET_SCHEMA=false
