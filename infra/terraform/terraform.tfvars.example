aws_region           = "eu-central-1"
availability_zone    = "eu-central-1a"
project_name         = "template-backend"
infrastructure_prefix = "template"

vpc_cidr          = "10.40.0.0/16"
public_subnet_cidr = "10.40.1.0/24"

environment_config = {
  development = {
    instance_type              = "t3.micro"
    root_volume_size           = 30
    eip_name                   = "template-backend-develop-eip"
    security_group_description = "Development backend HTTP and HTTPS"
    disable_api_stop           = false
    disable_api_termination    = false
  }
  production = {
    instance_type              = "t3.micro"
    root_volume_size           = 50
    eip_name                   = "template-backend-production-eip"
    security_group_description = "Production backend HTTP and HTTPS"
    disable_api_stop           = true
    disable_api_termination    = true
  }
}

# The current project uses an existing key pair. For a new project, prefer ssh_public_key
# or leave both values null and use SSM Session Manager only.
existing_ssh_key_name = "template-backend-key"
ssh_public_key        = null
ssh_ingress_cidr      = null

github_owner      = "bakberdy"
github_repository = "base_backend"

# Set this to an existing provider ARN when the AWS account already has GitHub OIDC.
# Leave null in a fresh account so Terraform creates it.
github_oidc_provider_arn = "arn:aws:iam::<account-id>:oidc-provider/token.actions.githubusercontent.com"

# Route53 is not used by the current account. Configure both values to manage DNS in AWS.
route53_zone_id = null
environment_domains = {
  # development = "dev-api.example.com"
  # production  = "api.example.com"
}
